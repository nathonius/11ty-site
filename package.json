{
  "name": "site",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "eleventy": "tsx ./node_modules/@11ty/eleventy/cmd.cjs --config=.eleventy.ts",
    "serve": "npm run eleventy -- --serve",
    "serve:jank": "concurrently \"npm run watch\" \"npm run sync\"",
    "serve:deno": "concurrently \"npm run watch:deno\" \"npm run sync\"",
    "watch": "tsx watch ./node_modules/@11ty/eleventy/cmd.cjs --config=.eleventy.ts",
    "deno": "deno --unstable-sloppy-imports -A ./node_modules/@11ty/eleventy/cmd.cjs --config=.eleventy.ts",
    "watch:deno": "deno --unstable-sloppy-imports --watch -A ./node_modules/@11ty/eleventy/cmd.cjs --config=.eleventy.ts",
    "sync": "browser-sync start --server --ss public --files \"./public/**/*.html\"",
    "build": "npm run eleventy && npm run index",
    "index": "pagefind --site \"public\" --glob \"**/*.html\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.10",
    "@types/through2": "^2.0.41",
    "autoprefixer": "^10.4.20",
    "browser-sync": "^3.0.3",
    "chokidar": "^3.6.0",
    "concurrently": "^9.1.1",
    "cross-env": "^7.0.3",
    "daisyui": "^4.12.23",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-unused-imports": "^4.0.1",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.16.5",
    "type-fest": "^4.23.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.1"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-img": "^4.0.2",
    "@11ty/eleventy-navigation": "^0.3.5",
    "@11ty/eleventy-plugin-directory-output": "^1.0.1",
    "@11ty/eleventy-plugin-rss": "^2.0.2",
    "@catppuccin/palette": "^1.2.0",
    "@shikijs/markdown-it": "^1.10.3",
    "eleventy-plugin-redirects": "^1.0.0",
    "jsx-async-runtime": "^0.6.2",
    "lucide-static": "^0.417.0",
    "markdown-it-obsidian-callouts": "^0.2.6",
    "pagefind": "^1.1.0",
    "preact": "^10.25.3",
    "preact-render-to-string": "^6.5.12"
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    }
  }
}
